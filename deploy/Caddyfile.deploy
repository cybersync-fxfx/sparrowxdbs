{
  # Bind Admin API strictly to the isolated sparrowx_control interface IP so untrusted
  # tenant containers on sparrowx_apps cannot reach port 2019 or tamper with routing.
  admin 172.28.0.10:2019
  on_demand_tls {
    ask http://control-plane:3000/api/deploy/internal/ask
  }
}

deploy.sparrowx.net {
  encode zstd gzip
  reverse_proxy control-plane:3000 {
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-Proto {scheme}
  }
}

# Wildcard & Verified Custom Domains (routes injected dynamically via Caddy Admin API)
https:// {
  tls {
    on_demand
  }
  encode zstd gzip
  reverse_proxy control-plane:3000 {
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-Proto {scheme}
  }
}

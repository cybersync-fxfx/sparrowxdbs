{
  admin 0.0.0.0:2019
  on_demand_tls {
    ask http://control-plane:3000/api/deploy/internal/ask
  }
}

deploy.sparrowx.net {
  encode zstd gzip
  reverse_proxy control-plane:3000 {
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-Proto {scheme}
  }
}

# Wildcard & Verified Custom Domains (routes injected dynamically via Caddy Admin API)
https:// {
  tls {
    on_demand
  }
  encode zstd gzip
  reverse_proxy control-plane:3000 {
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-Proto {scheme}
  }
}

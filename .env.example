# ============================================================================
# SparrowX Deploy (deploy.sparrowx.net) — Environment Configuration Template
# ============================================================================

NODE_ENV=production
SPARROWX_DOMAIN=sparrowx.net
SPARROWX_PUBLIC_IP=139.99.131.135
HTTP_PORT=80
HTTPS_PORT=443

# PostgreSQL 16 (Drizzle ORM)
POSTGRES_USER=sparrowx
POSTGRES_PASSWORD=replace_with_strong_32char_pg_password
POSTGRES_DB=sparrowx_db
DATABASE_URL=postgresql://sparrowx:replace_with_strong_32char_pg_password@postgres:5432/sparrowx_db

# Redis 7 (BullMQ Job Queue + SSE Live Log Pub/Sub)
REDIS_URL=redis://redis:6379

# Cryptography & SSO Secrets (generate with: openssl rand -hex 32)
SPARROWX_MASTER_SSO_SECRET=replace_with_64_hex_chars
SPARROWX_JWT_SECRET=replace_with_64_hex_chars
SPARROWX_ENCRYPTION_KEY=replace_with_64_hex_chars

# GitHub OAuth App (Repo Import + Push Webhooks)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=replace_with_webhook_hmac_secret

# Google OAuth 2.0 (Optional Unified SSO)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Worker & Edge Proxy Integration
SPARROWX_APPS_NETWORK=sparrowx_apps
SPARROWX_WORKER_CONCURRENCY=2
CADDY_ADMIN_URL=http://caddy:2019
# Optional fallback if using Nginx instead of Caddy:
# SPARROWX_NGINX_APPS_DIR=/etc/nginx/sparrowx-apps

# ==============================================================================
# SPARROWX ENTERPRISE CADDY CONFIGURATION
# 1. SparrowX Security Platform: sec.sparrowx.net
# 2. SparrowX DB Platform:       db.sparrowx.net
# 3. SparrowX DB API Gateway:    api.sparrowx.net
# ==============================================================================

{
    email admin@sparrowx.net
    auto_https disable_redirects
}

http://sec.sparrowx.net, https://sec.sparrowx.net {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
    }

    reverse_proxy sparrowx-studio:3000
}

http://db.sparrowx.net, https://db.sparrowx.net {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
    }

    reverse_proxy sparrowx-studio:3000
}

http://api.sparrowx.net, https://api.sparrowx.net {
    header {
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Authorization, apikey, Content-Type, Prefer"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
    }

    reverse_proxy sparrowx-postgrest:3000
}

# Catch-all IP address fallback so visiting http://139.99.131.135 also works instantly
:80 {
    reverse_proxy sparrowx-studio:3000
}

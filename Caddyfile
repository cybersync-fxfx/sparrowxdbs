# ==============================================================================
# SPARROWX ENTERPRISE CADDY CONFIGURATION
# 1. SparrowX DB Platform (Primary Canonical): db.sparrowx.net
# 2. SparrowX Security Platform:               sec.sparrowx.net
# 3. SparrowX DB API Gateway:                  api.sparrowx.net
# ==============================================================================

{
    email admin@sparrowx.net
}

# ------------------------------------------------------------------------------
# 1. SparrowX Master Company Portal: sparrowx.net & www.sparrowx.net
# ------------------------------------------------------------------------------
https://sparrowx.net, https://www.sparrowx.net {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
    }
    reverse_proxy sparrowx-studio:3000
}

# ------------------------------------------------------------------------------
# 2. Primary Canonical Database Endpoint: db.sparrowx.net
# ------------------------------------------------------------------------------
https://db.sparrowx.net {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
    }
    reverse_proxy sparrowx-studio:3000
}

# ------------------------------------------------------------------------------
# 2. Security Platform: sec.sparrowx.net
# ------------------------------------------------------------------------------
https://sec.sparrowx.net {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
    }
    reverse_proxy sparrowx-studio:3000
}

# ------------------------------------------------------------------------------
# 3. REST API Gateway: api.sparrowx.net
# ------------------------------------------------------------------------------
https://api.sparrowx.net {
    header {
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Authorization, apikey, Content-Type, Prefer"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
    }
    reverse_proxy sparrowx-postgrest:3000
}

# ------------------------------------------------------------------------------
# 4. HTTP Port 80 Ingress (Dual-protocol & ACME Challenges)
# ------------------------------------------------------------------------------
http://db.sparrowx.net, http://sec.sparrowx.net, http://api.sparrowx.net, :80 {
    @not_acme not path /.well-known/acme-challenge/*

    handle @not_acme {
        @api host api.sparrowx.net
        handle @api {
            reverse_proxy sparrowx-postgrest:3000
        }
        handle {
            reverse_proxy sparrowx-studio:3000
        }
    }
}

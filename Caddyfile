# ==============================================================================
# SPARROWX ENTERPRISE CADDY CONFIGURATION
# 1. SparrowX Security Platform: sec.sparrowx.net
# 2. SparrowX DB Platform:       db.sparrowx.net
# 3. SparrowX DB API Gateway:    api.sparrowx.net
# ==============================================================================

{
    email admin@sparrowx.net
}

# ------------------------------------------------------------------------------
# 1. HTTPS Endpoints (ZeroSSL / Let's Encrypt)
# ------------------------------------------------------------------------------
https://sec.sparrowx.net {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
    }
    reverse_proxy sparrowx-studio:3000
}

https://db.sparrowx.net {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
    }
    reverse_proxy sparrowx-studio:3000
}

https://api.sparrowx.net {
    header {
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Authorization, apikey, Content-Type, Prefer"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
    }
    reverse_proxy sparrowx-postgrest:3000
}

# ------------------------------------------------------------------------------
# 2. HTTP Port 80 Ingress (Preserves ACME challenges for Caddy, serves HTTP 200)
# ------------------------------------------------------------------------------
http://sec.sparrowx.net, http://db.sparrowx.net, http://api.sparrowx.net, :80 {
    # Exclude ACME challenge path so Caddy internal solver handles it with 200 OK
    @not_acme not path /.well-known/acme-challenge/*

    handle @not_acme {
        @api host api.sparrowx.net
        handle @api {
            reverse_proxy sparrowx-postgrest:3000
        }
        handle {
            reverse_proxy sparrowx-studio:3000
        }
    }
}

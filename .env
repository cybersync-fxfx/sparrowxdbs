# ==============================================================================
# SPARROWX ENTERPRISE ENVIRONMENT CONFIGURATION
# Primary Canonical Domain: https://db.sparrowx.net
# ==============================================================================

# Canonical URLs
VITE_APP_URL=https://db.sparrowx.net
PUBLIC_URL=https://db.sparrowx.net
APP_URL=https://db.sparrowx.net
SITE_URL=https://db.sparrowx.net
VITE_SITE_URL=https://db.sparrowx.net

# API Endpoints
API_URL=https://api.sparrowx.net
VITE_API_URL=https://api.sparrowx.net
VITE_SPARROWX_API_URL=https://api.sparrowx.net
VITE_SPARROWX_WS_URL=wss://api.sparrowx.net/realtime

# Sovereign Supabase / Database Compatibility
VITE_SOVEREIGN_SELF_HOSTED=true
VITE_SUPABASE_URL=https://api.sparrowx.net
VITE_SUPABASE_ANON_KEY=spx_ovh_sovereign_key

# Auth & Allowed Redirect URLs (Wildcards enabled for db and sec subdomains)
ADDITIONAL_REDIRECT_URLS=https://db.sparrowx.net/**,https://db.sparrowx.net/*,https://sec.sparrowx.net/**,https://api.sparrowx.net/**
GOTRUE_SITE_URL=https://db.sparrowx.net
GOTRUE_URI_ALLOW_LIST=https://db.sparrowx.net/**,https://sec.sparrowx.net/**

# Domains
DOMAIN_STUDIO=db.sparrowx.net
DOMAIN_SEC=sec.sparrowx.net
DOMAIN_API=api.sparrowx.net
